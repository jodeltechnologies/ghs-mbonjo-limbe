// The specification names Prisma for data access. In this build Prisma owns the
// schema and the migrations, while reads and writes go through the Supabase
// client carrying the signed-in person's session. That is a deliberate change,
// and the reason is in NOTES.md: Prisma connects as the database owner and so
// bypasses row level security, which Part 10.3 asks for by name. Running the
// queries through Supabase keeps those policies in force.
//
// The authority for the tables is supabase/01-schema.sql, which is what you
// paste into the SQL Editor. This file mirrors it so that migrations can be
// generated later if the school wants them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")        // the pooler, port 6543
  directUrl = env("DIRECT_URL")          // port 5432, for migrations
}

enum ServiceStatus   { active retired abandoned transferred unknown suspended }
enum EmploymentType  { permanent contract }
enum MatriculeStatus { valid irregular none }
enum DocumentType    { attestation certificate letter report_card }
enum DocumentStatus  { draft final cancelled }
enum ApprovalStatus  { draft pending approved rejected }

model Department {
  code    String @id
  nameEn  String @map("name_en")
  nameFr  String @map("name_fr")
  staff   Staff[]
  @@map("departments")
}

model Staff {
  id                      String          @id @default(uuid())
  displayName             String          @map("display_name")
  formerName              String          @default("") @map("former_name")
  sex                     String?
  dateOfBirth             DateTime?       @map("date_of_birth") @db.Date
  placeOfBirth            String?         @map("place_of_birth")
  maritalStatus           String?         @map("marital_status")
  regionOfOrigin          String?         @map("region_of_origin")
  divisionOfOrigin        String?         @map("division_of_origin")
  matriculeRaw            String?         @map("matricule_raw")
  matriculeNormalised     String?         @unique @map("matricule_normalised")
  matriculeStatus         MatriculeStatus @default(none) @map("matricule_status")
  employmentType          EmploymentType  @default(permanent) @map("employment_type")
  corps                   String?
  echelon                 String?
  salaryIndex             String?         @map("salary_index")
  specialty               String?
  primaryDepartment       String?         @map("primary_department")
  department              Department?     @relation(fields: [primaryDepartment], references: [code])
  dateAssumedDutyHere     DateTime?       @map("date_assumed_duty_here") @db.Date
  appointmentDecisionNo   String          @default("ON DUTY") @map("appointment_decision_no")
  phone                   String?
  whatsapp                String?
  serviceStatus           ServiceStatus   @default(active) @map("service_status")
  statusNote              String?         @map("status_note")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  roles       RoleAssignment[]
  documents   Document[]       @relation("DocumentSubjectStaff")
  @@map("staff")
}

model RoleAssignment {
  id         String    @id @default(uuid())
  staffId    String    @map("staff_id")
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role       String
  department String?
  note       String?
  startsOn   DateTime  @map("starts_on") @db.Date
  endsOn     DateTime? @map("ends_on")   @db.Date
  @@map("role_assignments")
}

model Student {
  id           String    @id @default(uuid())
  schoolNumber String?   @map("school_number")
  matricule    String?
  displayName  String    @map("display_name")
  sex          String?
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  placeOfBirth String?   @map("place_of_birth")
  @@map("students")
}

model Document {
  id               String         @id @default(uuid())
  reference        String
  referenceManual  Boolean        @default(false) @map("reference_manual")
  type             DocumentType
  status           DocumentStatus @default(final)
  subjectStaffId   String?        @map("subject_staff_id")
  subjectStaff     Staff?         @relation("DocumentSubjectStaff", fields: [subjectStaffId], references: [id])
  issuedOn         DateTime       @map("issued_on") @db.Date
  cancelledReason  String?        @map("cancelled_reason")
  snapshot         Json
  @@map("documents")
}
